#!/bin/bash

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Helper Functions
command_exists() {
  command -v "$1" &> /dev/null
}

is_nextjs() {
  [ -f "next.config.js" ] || [ -f "next.config.mjs" ] || [ -f "next.config.ts" ] || [ -d ".next" ]
}

is_vite() {
  [ -f "vite.config.js" ] || [ -f "vite.config.ts" ] || [ -d "dist" ]
}

log_success() {
  echo -e "${GREEN}✅ $1${NC}"
}

log_error() {
  echo -e "${RED}❌ $1${NC}"
}

log_info() {
  echo -e "${BLUE}ℹ️  $1${NC}"
}

log_warning() {
  echo -e "${YELLOW}⚠️  $1${NC}"
}

log_action() {
  echo -e "${CYAN}🔄 $1${NC}"
}

remove_with_feedback() {
  local target="$1"
  if [ -e "$target" ]; then
    log_action "🧹 Removing ${target}..."
    rm -rf "$target"
    if [ $? -eq 0 ]; then
      log_success "Removed ${target}."
      return 0
    else
      log_error "Failed to remove ${target}."
      return 1
    fi
  else
    log_info "${target} not found, skipping."
    return 0
  fi
}

get_open_cmd() {
  case "$(uname -s)" in
    Linux*) echo "xdg-open" ;;
    Darwin*) echo "open" ;;
    CYGWIN*|MINGW*|MSYS*) echo "start" ;;
    *) echo "" ;;
  esac
}

# Determine package manager based on flags
get_package_manager() {
  # Check for flags
  for arg in "$@"; do
    case "$arg" in
      --b | --bun | -b | -bun | --b | -bun)
        if command_exists bun; then
          echo "bun"
          return 0
        else
          log_warning \
            "Bun flag detected but bun is not installed. Falling back to default."
        fi
        ;;
    esac
  done

  # Default to pnpm if available
  if command_exists pnpm; then
    echo "pnpm"
    return 0
  elif command_exists bun; then
    echo "bun"
    return 0
  elif command_exists npm; then
    echo "npm"
    return 0
  elif command_exists yarn; then
    echo "yarn"
    return 0
  else
    echo ""
    return 1
  fi
}

# Core Functions
rmall() {
  echo -e "${MAGENTA}🚀 Running rmall...${NC}"
  local success=true

  remove_with_feedback "node_modules" || success=false

  if is_nextjs; then
    echo -e "${CYAN}⚛️  Detected Next.js project.${NC}"
    remove_with_feedback ".next" || success=false
    if is_vite; then
      log_warning "Both Next.js and Vite configurations found. This is unusual."
    fi
  elif is_vite; then
    echo -e "${CYAN}⚡ Detected Vite project.${NC}"
    remove_with_feedback "dist" || success=false
  else
    log_info "No specific framework detected. Only removing node_modules."
  fi

  if $success; then
    log_success "rmall completed successfully! 🎉"
    return 0
  else
    log_error "rmall completed with errors. 😢"
    return 1
  fi
}

re() {
  echo -e "${MAGENTA}🔄 Running re (rmall + package install)...${NC}"

  # Get package manager based on flags
  local pm=$(get_package_manager "$@")
  if [ -z "$pm" ]; then
    log_error "No package manager found. Please install pnpm, bun, npm, or yarn."
    return 1
  fi

  log_info "Using package manager: $pm"

  if ! rmall; then
    log_error "Aborting re due to errors in rmall."
    return 1
  fi

  if [ ! -f "package.json" ]; then
    log_error "Error: 'package.json' not found."
    return 1
  fi

  log_action "📦 Installing dependencies with $pm..."
  $pm install
  if [ $? -eq 0 ]; then
    log_success "Dependencies installed successfully! 🎉"
    return 0
  else
    log_error "Failed to install dependencies."
    return 1
  fi
}

check_node_modules() {
  if [ ! -d "node_modules" ]; then
    log_warning "node_modules not found! Installing dependencies first..."

    # Get package manager based on flags
    local pm=$(get_package_manager "$@")
    if [ -z "$pm" ]; then
      log_error "No package manager found. Please install dependencies manually."
      return 1
    fi

    log_info "Using package manager: $pm"
    $pm install

    if [ $? -eq 0 ]; then
      log_success "Dependencies installed successfully! 🎉"
    else
      log_error "Failed to install dependencies."
      return 1
    fi
  fi
  return 0
}

run_server_and_open() {
  local script_name="$1"
  shift # Remove first argument, leaving the rest as potential flags

  # Get package manager based on flags
  local package_manager=$(get_package_manager "$@")
  if [ -z "$package_manager" ]; then
    log_error "No package manager found. Please install pnpm, bun, npm, or yarn."
    return 1
  fi

  log_info "Using package manager: $package_manager"

  if ! command_exists jq; then
    log_error "Error: 'jq' command not found."
    return 1
  fi
  if [ ! -f "package.json" ]; then
    log_error "Error: 'package.json' not found."
    return 1
  fi

  # Check for node_modules
  check_node_modules "$@" || return 1

  if [ "$script_name" = "auto" ]; then
    if jq -e '.scripts.dev | strings | length > 0' package.json > /dev/null; then
      script_name="dev"
      log_success "Using 'dev' script."
    elif jq -e '.scripts.start | strings | length > 0' package.json > /dev/null; then
      script_name="start"
      log_success "Using 'start' script."
    else
      log_error "Error: No 'dev' or 'start' script found."
      return 1
    fi
  else
    # Check if specified script exists
    if ! jq -e ".scripts.$script_name | strings | length > 0" package.json > /dev/null; then
      log_error "Error: Script '$script_name' not found in package.json."
      return 1
    fi
  fi

  # Detect project type
  if is_nextjs; then
    echo -e "${CYAN}⚛️  Starting Next.js development server...${NC}"
  elif is_vite; then
    echo -e "${CYAN}⚡ Starting Vite development server...${NC}"
  else
    log_info "Starting development server (framework unknown)..."
  fi

  local open_cmd=$(get_open_cmd)
  echo -e "${MAGENTA}🚀 Starting server via '$package_manager run $script_name'...\
${NC}"

  # Run the command and process the output line by line to find URLs
  local url_found=false
  $package_manager run "$script_name" 2>&1 | while IFS= read -r line; do
    echo "$line"
    if ! $url_found && [ -n "$open_cmd" ]; then
      url=$(
        echo "$line" | grep -oE '(http://|https://)(localhost|127\.0\.0\.1|0\.0\.0\.0):\
[0-9]+' | head -n 1
      )
      if [ -n "$url" ]; then
        log_success "Opening: $url 🌐"
        "$open_cmd" "$url" &>/dev/null &
        url_found=true
      fi
    fi
  done
  return 0
}

# Universal command for development server
dev() {
  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: dev [options]"
    echo "Starts the development server using the appropriate package manager."
    echo
    echo "Options:"
    echo "  -b, --bun     Use bun as the package manager."
    echo "  --help, -h    Show this help message and exit."
    echo
    echo "Examples:"
    echo "  dev           Start the development server."
    echo "  dev --bun     Start the development server using bun."
    return 0
  fi

  echo -e "${MAGENTA}🚀 Starting development server...${NC}"
  run_server_and_open "auto" "$@"
}

# Command aliases for different package managers
de() {
  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: de [options]"
    echo "Alias for 'dev'. Starts the development server using the appropriate \
package manager."
    echo
    echo "Options:"
    echo "  -b, --bun     Use bun as the package manager."
    echo "  --help, -h    Show this help message and exit."
    echo
    echo "Examples:"
    echo "  de           Start the development server."
    echo "  de --bun     Start the development server using bun."
    return 0
  fi
  dev "$@"
}

# Build command with package manager detection
build() {
  echo -e "${MAGENTA}🏗️  Running build...${NC}"

  # Get package manager based on flags
  local package_manager=$(get_package_manager "$@")
  if [ -z "$package_manager" ]; then
    log_error "No package manager found. Please install pnpm, bun, npm, or yarn."
    return 1
  fi

  log_info "Using package manager: $package_manager"

  if [ ! -f "package.json" ]; then
    log_error "Error: 'package.json' not found."
    return 1
  fi

  # Check for node_modules
  check_node_modules "$@" || return 1

  if jq -e '.scripts.build | strings | length > 0' package.json > /dev/null; then
    # Detect project type for better feedback
    if is_nextjs; then
      echo -e "${CYAN}⚛️  Building Next.js project...${NC}"
    elif is_vite; then
      echo -e "${CYAN}⚡ Building Vite project...${NC}"
    else
      log_info "Building project (framework unknown)..."
    fi

    log_action "Running '$package_manager run build'..."
    $package_manager run build
    if [ $? -eq 0 ]; then
      log_success "Build completed successfully! 🎉"
      return 0
    else
      log_error "Build failed. 😢"
      return 1
    fi
  else
    log_error "Error: No 'build' script found in package.json."
    return 1
  fi
}

b() {
  build "$@"
}

# Install command with package manager detection
install() {
  # Get package manager based on flags
  local package_manager=$(get_package_manager "$@")
  if [ -z "$package_manager" ]; then
    log_error "No package manager found. Please install pnpm, bun, npm, or yarn."
    return 1
  fi

  echo -e "${MAGENTA}📦 Running $package_manager install...${NC}"
  $package_manager install
  if [ $? -eq 0 ]; then
    log_success "Dependencies installed successfully! 🎉"
    return 0
  else
    log_error "Failed to install dependencies."
    return 1
  fi
}

i() {
  install "$@"
}

rebuild() {
  echo -e "${MAGENTA}🛠️  Running rebuild (re + run dev server)...${NC}"
  if ! re "$@"; then
    log_error "Aborting rebuild due to errors."
    return 1
  fi
  dev "$@"
}

# Legacy command aliases for backwards compatibility
be() {
  dev --bun
}

bb() {
  build --bun
}

bi() {
  install --bun
}

# Alias Setup
setup_aliases() {
  if [ -n "$BASH_VERSION" ]; then
    shell_rc_file="$HOME/.bashrc"
  elif [ -n "$ZSH_VERSION" ]; then
    shell_rc_file="${ZDOTDIR:-$HOME}/.zshrc"
  else
    log_error "Shell not supported. Requires Bash or Zsh."
    return 1
  fi
}
